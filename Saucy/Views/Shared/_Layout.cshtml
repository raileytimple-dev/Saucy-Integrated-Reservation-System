@inject CartService Cart
@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("FullName");
    var isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
    var path = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Saucy Herbs Cuisine</title>
<link rel="icon" href="~/legacy/Images/Icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/customer-refresh.css" asp-append-version="true" />
</head>
<body class="customer-body">
<nav class="navbar navbar-expand-lg navbar-dark saucy-navbar sticky-top">
<div class="container-xl">
<a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index"><img src="~/legacy/logo/logosaucy.png" class="brand-logo" onerror="this.src='/legacy/Images/Icon.png'"/><span>Saucy Herbs Cuisine</span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav">
<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
<li class="nav-item"><a class="nav-link @(path=="/"||path.StartsWith("/Home")?"active":"")" asp-controller="Home" asp-action="Index">Home</a></li>
<li class="nav-item"><a class="nav-link @(path.StartsWith("/Menu")?"active":"")" asp-controller="Menu" asp-action="Index">Menu</a></li>
<li class="nav-item"><a class="nav-link @(path.StartsWith("/Reservations")?"active":"")" asp-controller="Reservations" asp-action="Create">Reservation</a></li>
<li class="nav-item"><a class="nav-link @(path.Contains("Track")?"active":"")" asp-controller="Orders" asp-action="Track">Track Orders</a></li>
<li class="nav-item"><a class="nav-link @(path.Contains("History")?"active":"")" asp-controller="Orders" asp-action="History">Order History</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
@if(isLoggedIn){<li class="nav-item"><a class="cart-link" asp-controller="Cart" asp-action="Index" title="Cart"><i class="bi bi-cart3"></i><span class="cart-count">@Cart.Count</span></a></li>}
@if(string.IsNullOrWhiteSpace(name)){
<li class="nav-item"><a class="btn btn-warning fw-semibold ms-lg-2" asp-controller="Account" asp-action="Login">Log In</a></li>
}else{
<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@name</a><ul class="dropdown-menu dropdown-menu-end"><li><span class="dropdown-item-text small text-muted">@role</span></li>@if(role=="Admin"){<li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>}@if(role=="Staff"){<li><a class="dropdown-item" asp-controller="Staff" asp-action="Orders">Staff Orders</a></li>}<li><hr class="dropdown-divider"/></li><li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item">Log out</button></form></li></ul></li>
}
</ul></div></div></nav>
<main class="customer-content">@if(TempData["Success"]!=null){<div class="container-xl pt-3"><div class="alert alert-success">@TempData["Success"]</div></div>}@if(TempData["Error"]!=null){<div class="container-xl pt-3"><div class="alert alert-danger">@TempData["Error"]</div></div>}@RenderBody()</main>
<footer class="saucy-footer"><div class="container-xl footer-grid"><div><img src="~/legacy/logo/logosaucy.png" class="footer-logo" onerror="this.style.display='none'"/><p class="mb-0">Saucy Herbs Cuisine</p><small>Good food, shared moments.</small></div><div><strong>Quick Links</strong><a asp-controller="Menu" asp-action="Index">Menu</a><a asp-controller="Reservations" asp-action="Create">Reservations</a><a asp-controller="Orders" asp-action="Track">Track Orders</a></div><div><strong>Account</strong><a asp-controller="Account" asp-action="Login">Log In</a><a asp-controller="Account" asp-action="Register">Create Account</a></div><div><strong>Follow us</strong><div class="fs-4"><i class="bi bi-facebook me-2"></i><i class="bi bi-instagram me-2"></i><i class="bi bi-twitter-x"></i></div></div></div><div class="copyright">© @DateTime.Now.Year Saucy Herbs Cuisine</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required:false)
</body></html>

@{
    var name = Context.Session.GetString("FullName") ?? "Administrator";
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string action) => path.Equals($"/Admin/{action}", StringComparison.OrdinalIgnoreCase) ||
        (action == "Index" && (path.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || path.Equals("/Admin/", StringComparison.OrdinalIgnoreCase)));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Saucy Admin</title>
    <link rel="icon" href="~/legacy/logo/logosaucy.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-refresh.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Admin" asp-action="Index">
            <img src="~/legacy/logo/logosaucy.png" alt="Saucy logo" onerror="this.style.display='none'" />
            <div><strong>Saucy</strong><small>ADMIN CENTER</small></div>
        </a>
        <div class="workspace-role-card">
            <i class="bi bi-shield-check"></i>
            <div><strong>Business control</strong><small>Approvals, setup, money and records</small></div>
        </div>
        <nav aria-label="Admin navigation">
            <div class="nav-group">
                <h6>Overview</h6>
                <a asp-controller="Admin" asp-action="Index" class="@(IsActive("Index") ? "active" : "")"><i class="bi bi-grid-1x2"></i><span>Dashboard<small>Tasks that need attention</small></span></a>
            </div>
            <div class="nav-group">
                <h6>Restaurant service</h6>
                <a asp-controller="Admin" asp-action="Reservations" class="@(IsActive("Reservations") ? "active" : "")"><i class="bi bi-calendar2-check"></i><span>Reservations<small>Review and confirm requests</small></span></a>
                <a asp-controller="Admin" asp-action="DiningTables" class="@(IsActive("DiningTables") ? "active" : "")"><i class="bi bi-grid-3x3-gap"></i><span>Dining room<small>Tables, walk-ins and seating</small></span></a>
                <a asp-controller="Admin" asp-action="Orders" class="@(IsActive("Orders") ? "active" : "")"><i class="bi bi-receipt"></i><span>Order oversight<small>Monitor or correct an order</small></span></a>
            </div>
            <div class="nav-group">
                <h6>Sales and catalog</h6>
                <a asp-controller="Admin" asp-action="Payments" class="@(IsActive("Payments") ? "active" : "")"><i class="bi bi-credit-card"></i><span>Payments<small>Confirm cash and view QR</small></span></a>
                <a asp-controller="Admin" asp-action="Menu" class="@(IsActive("Menu") ? "active" : "")"><i class="bi bi-journal-text"></i><span>Menu &amp; sauces<small>Prices and availability</small></span></a>
            </div>
            <div class="nav-group">
                <h6>Records and access</h6>
                <a asp-controller="Admin" asp-action="Transactions" class="@(IsActive("Transactions") ? "active" : "")"><i class="bi bi-cash-stack"></i><span>Transactions<small>Automatic payment records</small></span></a>
                <a asp-controller="Admin" asp-action="Refunds" class="@(IsActive("Refunds") ? "active" : "")"><i class="bi bi-arrow-counterclockwise"></i><span>Refund requests<small>Approve or decline</small></span></a>
                <a asp-controller="Admin" asp-action="Accounts" class="@(IsActive("Accounts") ? "active" : "")"><i class="bi bi-people"></i><span>Accounts<small>Customers, staff and admins</small></span></a>
            </div>
        </nav>
    </aside>
    <header class="admin-header">
        <div class="admin-header-title"><small>ADMIN WORKSPACE</small><strong>@ViewData["Title"]</strong></div>
        <div class="admin-user-menu">
            <span class="admin-user-avatar">@name[..1].ToUpperInvariant()</span>
            <span class="admin-user-name"><strong>@name</strong><small>Administrator</small></span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn admin-logout"><i class="bi bi-box-arrow-right"></i><span>Log out</span></button></form>
        </div>
    </header>
    <main class="admin-main">
        @if (TempData["Success"] != null) { <div class="alert alert-success admin-alert"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger admin-alert"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div> }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

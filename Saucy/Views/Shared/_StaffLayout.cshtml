@{
    var name = Context.Session.GetString("FullName") ?? "Staff";
    var path = Context.Request.Path.Value ?? "";
    bool IsActive(string action) => path.Equals($"/Staff/{action}", StringComparison.OrdinalIgnoreCase) ||
        (action == "Index" && (path.Equals("/Staff", StringComparison.OrdinalIgnoreCase) || path.Equals("/Staff/", StringComparison.OrdinalIgnoreCase)));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Saucy Staff</title>
    <link rel="icon" href="~/legacy/logo/logosaucy.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-refresh.css" asp-append-version="true" />
</head>
<body class="admin-body staff-body">
    <aside class="admin-sidebar staff-sidebar">
        <a class="admin-brand" asp-controller="Staff" asp-action="Index">
            <img src="~/legacy/logo/logosaucy.png" alt="Saucy logo" />
            <div><strong>Saucy</strong><small>STAFF STATION</small></div>
        </a>
        <div class="workspace-role-card staff-role-card">
            <i class="bi bi-fire"></i>
            <div><strong>Service operations</strong><small>Prepare paid orders and mark them ready</small></div>
        </div>
        <nav aria-label="Staff navigation">
            <div class="nav-group">
                <h6>Your workspace</h6>
                <a asp-controller="Staff" asp-action="Index" class="@(IsActive("Index") ? "active" : "")"><i class="bi bi-house-door"></i><span>Staff home<small>Queue summary and workflow</small></span></a>
                <a asp-controller="Staff" asp-action="Orders" class="@(IsActive("Orders") ? "active" : "")"><i class="bi bi-receipt-cutoff"></i><span>Active orders<small>Prepare, ready, complete</small></span></a>
                <a asp-controller="Staff" asp-action="History" class="@(IsActive("History") ? "active" : "")"><i class="bi bi-clock-history"></i><span>Order history<small>Completed and cancelled</small></span></a>
            </div>
        </nav>
        <div class="sidebar-help"><i class="bi bi-info-circle"></i><p><strong>Staff cannot manage payments or accounts.</strong> Ask an administrator when an order is unpaid or needs a correction.</p></div>
    </aside>
    <header class="admin-header staff-header">
        <div class="admin-header-title"><small>STAFF WORKSPACE</small><strong>@ViewData["Title"]</strong></div>
        <div class="admin-user-menu">
            <span class="admin-user-avatar">@name[..1].ToUpperInvariant()</span>
            <span class="admin-user-name"><strong>@name</strong><small>Service staff</small></span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn admin-logout"><i class="bi bi-box-arrow-right"></i><span>Log out</span></button></form>
        </div>
    </header>
    <main class="admin-main">
        @if (TempData["Success"] != null) { <div class="alert alert-success admin-alert"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger admin-alert"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div> }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

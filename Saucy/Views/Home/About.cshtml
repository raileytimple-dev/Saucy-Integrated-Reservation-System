@{ ViewData["Title"] = "About Us"; }

<section class="about-hero">
    <div class="container-xl about-hero-grid">
        <div>
            <span class="eyebrow eyebrow-light">Our neighborhood story</span>
            <h1>Small food chain.<br />Big Saucy flavor.</h1>
            <p>Saucy Inc. is a homegrown Filipino food concept serving comforting, student-friendly meals near Mapúa Malayan Colleges Laguna.</p>
        </div>
        <div class="about-location-card">
            <i class="bi bi-geo-alt-fill"></i>
            <div><small>Find us near Mapúa MCL</small><strong>South Point Subdivision, Barangay Pulo</strong><span>Cabuyao, Laguna 4025</span></div>
            <a href="https://www.google.com/maps/search/?api=1&query=Saucy+South+Point+Subdivision+Pulo+Cabuyao+Laguna" target="_blank" rel="noopener" aria-label="Open Saucy location in Google Maps"><i class="bi bi-arrow-up-right"></i></a>
        </div>
    </div>
</section>

<section class="section-pad about-story-section">
    <div class="container-xl about-story-grid">
        <div class="about-story-photo"><img src="~/legacy/Images/banner1.png" alt="A Saucy signature meal" /></div>
        <div class="about-story-copy">
            <span class="eyebrow">About Saucy Inc.</span>
            <h2>A familiar stop for the Mapúa MCL community.</h2>
            <p>Located in South Point Subdivision in Barangay Pulo, Cabuyao, Saucy has become one of the nearby food spots where students and friends gather for rice meals, pasta, sides, drinks, and signature sauces.</p>
            <p>This website brings that restaurant experience online—letting customers explore the menu, reserve tables, place orders, track their food, and revisit previous orders from one convenient place.</p>
            <a class="about-social-link" href="https://www.instagram.com/SaucyHerbsCuisine" target="_blank" rel="noopener"><i class="bi bi-instagram"></i> Follow Saucy Herbs Cuisine</a>
        </div>
    </div>
</section>

<section class="section-pad team-section">
    <div class="container-xl">
        <div class="section-heading">
            <span class="eyebrow">The project team</span>
            <h2>Meet the people behind the website.</h2>
            <p>A collaborative system-design and user-interface project built around Saucy's customer and restaurant workflows.</p>
        </div>
        <div class="team-grid">
            <article class="team-card team-card-featured"><span>JT</span><div><h3>John Railey Timple</h3><strong>Database &amp; System Flow</strong><p>Designed the database and developed the functionality and navigation flow across the website.</p></div></article>
            <article class="team-card"><span>AO</span><div><h3>Alyssa Opina</h3><strong>User Interface Design</strong><p>Created and refined the visual experience and customer-facing page designs.</p></div></article>
            <article class="team-card"><span>YM</span><div><h3>Yowanna Andwele Montibon</h3><strong>User Interface Design</strong><p>Developed the page layouts and helped shape a consistent, accessible interface.</p></div></article>
            <article class="team-card"><span>RC</span><div><h3>Rojan Ezail Cana</h3><strong>Quality Assurance &amp; Documentation</strong><p>Reviewed user flows, tested core features, and organized supporting project documentation.</p></div></article>
        </div>
    </div>
</section>
